MONGODB_URI="mongodb+srv://pvp4229182_db_user:<db_password>@cluster0.pthnxjw.mongodb.net/?appName=Cluster0"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
PORT=4000
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
NODE_ENV=development

# Resend (https://resend.com) settings used for role invitation emails
RESEND_API_KEY=
EMAIL_FROM=Lead CRM <no-reply@yourdomain.com>
INVITE_EXPIRES_HOURS=72

# WhatsApp Cloud API (Meta) — see https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-string-you-choose
WHATSAPP_APP_SECRET=

# AI provider for the WhatsApp sales agent. AI_PROVIDER=mock (default) needs no key and
# runs the pipeline against heuristic canned responses. Set anthropic, openai, or
# openrouter + AI_API_KEY for real replies; AI_MODEL is optional and defaults per provider.
# openrouter (https://openrouter.ai) gives access to many models through one API key —
# get a key at https://openrouter.ai/keys and set AI_MODEL to e.g. "openai/gpt-4o-mini",
# "anthropic/claude-sonnet-5", or "meta-llama/llama-3.3-70b-instruct".
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
# Optional, openrouter only: comma-separated models tried in order when the primary one is
# rate-limited or unavailable. Free-tier models share a pool and return 429 often, so a
# fallback keeps the agent replying. Leave blank to never route away from AI_MODEL —
# listing a paid model here means those requests are billed.
AI_FALLBACK_MODELS=

# Shared secret required on POST /api/whatsapp/jobs/run-followups (used by Vercel Cron
# or any external scheduler in place of node-cron, which can't run on serverless).
CRON_SECRET=

# The ARIA automation engine needs no environment variables of its own: templates,
# triggers, conditions, delays and lead-scoring rules all live in MongoDB and are edited
# from WhatsApp Automation in the CRM. It uses the WhatsApp and AI credentials above, and
# CRON_SECRET above for the scheduled follow-up / delayed-automation runs.
